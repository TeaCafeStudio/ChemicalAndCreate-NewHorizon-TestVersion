{"id":"ponderer:fission_fuel_assembly","items":["mekanismgenerators:fission_fuel_assembly"],"title":{"en_us":"Fission Fuel Assembly","zh_cn":"裂变燃料组件"},"structures":["ponderer:basic_xxl"],"tags":[],"steps":[],"scenes":[{"id":"build_overview","title":{"en_us":"Platform Overview","zh_cn":"平台概览"},"steps":[{"type":"show_structure","structure":"ponderer:basic_xxl","scale":0.75,"attachKeyFrame":true},{"type":"text","duration":60,"text":{"en_us":"A single-layer platform with a snow block and white concrete checkerboard pattern. We will demonstrate the fission fuel assembly here.","zh_cn":"由雪块和白色混凝土交替排列组成的单层棋盘格平台。我们将在此演示裂变燃料组件。"},"point":[7.5,0.5,7.5],"color":"blue","placeNearTarget":true},{"type":"idle","duration":60}]},{"id":"crafting_and_usage","title":{"en_us":"Crafting & Usage","zh_cn":"合成与使用"},"steps":[{"type":"show_structure","structure":"ponderer:basic_xxl","scale":0.75,"attachKeyFrame":true},{"type":"text","duration":50,"text":{"en_us":"The fission fuel assembly is crafted from the following materials:","zh_cn":"裂变燃料组件由以下材料合成："},"point":[7.5,0.5,7.5],"color":"green","placeNearTarget":true},{"type":"idle","duration":60},{"type":"show_controls","point":[3.0,1.5,3.0],"direction":"down","item":"mekanism:ingot_lead","duration":50,"attachKeyFrame":true},{"type":"text","duration":50,"text":{"en_us":"Crafting material 1: Lead Ingots (6 required)","zh_cn":"合成材料之一：铅锭（需要6个）"},"point":[3.0,1.0,3.0],"color":"input","placeNearTarget":true},{"type":"idle","duration":60},{"type":"clear_item_entities","fullScene":true},{"type":"show_controls","point":[7.0,1.5,3.0],"direction":"down","item":"mekanism:ingot_steel","duration":50,"attachKeyFrame":true},{"type":"text","duration":50,"text":{"en_us":"Crafting material 2: Steel Ingots (2 required)","zh_cn":"合成材料之二：钢锭（需要2个）"},"point":[7.0,1.0,3.0],"color":"input","placeNearTarget":true},{"type":"idle","duration":60},{"type":"clear_item_entities","fullScene":true},{"type":"show_controls","point":[11.0,1.5,3.0],"direction":"down","item":"mekanism:basic_chemical_tank","duration":50,"attachKeyFrame":true},{"type":"text","duration":50,"text":{"en_us":"Crafting material 3: Basic Chemical Tank (1 required)","zh_cn":"合成材料之三：基础化学品储罐（需要1个）"},"point":[11.0,1.0,3.0],"color":"input","placeNearTarget":true},{"type":"idle","duration":60},{"type":"clear_item_entities","fullScene":true},{"type":"set_block","block":"mekanismgenerators:fission_fuel_assembly","blockPos":[7,1,7],"spawnParticles":true,"attachKeyFrame":true},{"type":"text","duration":50,"text":{"en_us":"The fission fuel assembly is placed inside the fission reactor multiblock.","zh_cn":"裂变燃料组件放置在裂变反应堆多方块结构内部。"},"point":[7.0,1.5,7.5],"color":"blue","placeNearTarget":true},{"type":"idle","duration":60},{"type":"create_item_entity","item":"mekanismgenerators:fission_fuel_assembly","pos":[7.5,2.5,7.5],"motion":[0,0,0]},{"type":"text","duration":50,"text":{"en_us":"Each fuel assembly adds 1mb/t of maximum burn rate to the reactor.","zh_cn":"每个燃料组件可为反应堆增加 1mb/t 的最大燃烧速率。"},"point":[7.0,2.5,7.5],"color":"green","placeNearTarget":true,"attachKeyFrame":true},{"type":"idle","duration":60},{"type":"show_controls","point":[7.0,2.5,7.5],"direction":"up","item":"mekanismgenerators:fission_fuel_assembly","duration":50},{"type":"text","duration":50,"text":{"en_us":"Adding more assemblies linearly increases the reactor's maximum throughput.","zh_cn":"增加更多组件，可线性提升反应堆的最大处理能力。"},"point":[10.5,2.0,7.5],"color":"blue","placeNearTarget":true},{"type":"idle","duration":60},{"type":"set_block","block":"mekanismgenerators:control_rod_assembly","blockPos":[7,2,7],"spawnParticles":true,"attachKeyFrame":true},{"type":"text","duration":50,"text":{"en_us":"Important: A control rod assembly must be placed on top of the fuel assembly.","zh_cn":"重要：燃料棒顶部必须放置控制棒组件。"},"point":[7.0,2.5,7.5],"color":"red","placeNearTarget":true},{"type":"idle","duration":60},{"type":"show_controls","point":[7.0,2.5,7.5],"direction":"up","item":"mekanismgenerators:control_rod_assembly","duration":50},{"type":"text","duration":50,"text":{"en_us":"Without the control rod assembly, the reactor will not function properly.","zh_cn":"缺少控制棒组件将导致反应堆无法正常工作。"},"point":[10.5,2.0,7.5],"color":"red","placeNearTarget":true},{"type":"indicate_success","blockPos":[7,1,7],"attachKeyFrame":true},{"type":"idle","duration":60}]}]}