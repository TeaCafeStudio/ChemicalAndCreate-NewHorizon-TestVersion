// KubeJS Ponder for Storage System (neoecoae) - MC 1.21.1
Ponder.registry((event) => {
  event
    .create('neoecoae:storage_system_l4')
    .scene('存储计算机使用', 'storage_system_l4', (scene, util) => {
      scene.showBasePlate()
      scene.idle(10)

      scene.world.setBlock([4, 2, 2], 'neoecoae:storage_system_l4', true)
      scene.idle(20)

      scene.text(80, '右键打开存储计算机主界面')
        .placeNearTarget()
        .pointAt(util.vector.blockSurface([4, 2, 2], 'up'))

      scene.idle(80)
      scene.showControls(60, util.vector.of(4, 2, 2), 'up', 'right')

      scene.idle(70)
      scene.text(100, '此结构可形成更大的存储群组，提升容量与功能')
        .placeNearTarget()
        .pointAt(util.vector.blockSurface([4, 2, 2], 'up'))

      scene.idle(100)
    })
})
